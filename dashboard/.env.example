# Neon pooled connection string for the read-only dashboard_ro role.
DASHBOARD_DATABASE_URL=postgresql://dashboard_ro:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Password for the browser's login prompt (any username). Optional locally,
# required on Vercel: without it the deployment refuses all requests.
DASHBOARD_PASSWORD=choose-a-password

# Optional: the bot's token, used to look up server and user names from
# Discord (cached a day per ID). Without it the dashboard shows raw IDs.
DASHBOARD_DISCORD_TOKEN=
